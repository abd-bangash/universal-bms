  customer      Customer  @relation(fields: [customerId], references: [id])
  issuedAt      DateTime  @default(now()) @map("issued_at")
  totalAmount   Decimal   @map("total_amount") @db.Decimal(18, 4)
  /// The immutable snapshot the PDF is rendered from.
  data          Json
  issuedById    String?   @map("issued_by_id")

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, orderId])
  @@map("invoices")
}

model Return {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  returnNumber String       @map("return_number")
  orderId      String       @map("order_id")
  order        Order        @relation(fields: [orderId], references: [id])
  customerId   String       @map("customer_id")
  customer     Customer     @relation(fields: [customerId], references: [id])
  reason       String
  refundAmount Decimal      @map("refund_amount") @db.Decimal(18, 4)
  refundTo     String       @map("refund_to")
  posSessionId String?      @map("pos_session_id")
  posSession   PosSession?  @relation(fields: [posSessionId], references: [id])
  createdById  String?      @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  lines        ReturnLine[]
  payments     Payment[]

  @@unique([workspaceId, returnNumber])
  @@index([workspaceId, orderId])
  @@map("returns")
}

model ReturnLine {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  returnId    String    @map("return_id")
  return      Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Decimal   @db.Decimal(18, 4)
  amount      Decimal   @db.Decimal(18, 4)
  restock     Boolean   @default(true)

  @@index([workspaceId, returnId])
  @@map("return_lines")
}

// ═══ Finance (task 39) ═══════════════════════════════════════════════════

enum PaymentType {
  ORDER_PAYMENT
  DEPOSIT
  ADVANCE
  CREDIT_APPLIED
  REFUND

  @@map("payment_type")
}

enum PaymentStatus {
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
  VOIDED

  @@map("payment_status")
}

model FinancialAccount {
  id               String            @id @default(cuid())
  workspaceId      String            @map("workspace_id")
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  /// CASH | BANK | MOBILE_WALLET | CARD_TERMINAL
  type             String
  name             String
  bankName         String?           @map("bank_name")
  accountTitle     String?           @map("account_title")
  accountNumber    String?           @map("account_number")
  branch           String?
  showToCustomers  Boolean           @default(false) @map("show_to_customers")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  methods          PaymentMethod[]
  payments         Payment[]
  expenses         Expense[]
  supplierPayments SupplierPayment[]

  @@unique([workspaceId, name])
  @@map("financial_accounts")
}

model PaymentMethod {
  id                String            @id @default(cuid())
  workspaceId       String            @map("workspace_id")
  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  name              String
  /// CASH | CARD | BANK_TRANSFER | MOBILE_MONEY | OTHER
  type              String
  accountId         String            @map("account_id")
  account           FinancialAccount  @relation(fields: [accountId], references: [id])
  requiresReference Boolean           @default(false) @map("requires_reference")
  active            Boolean           @default(true)
  payments          Payment[]
  expenses          Expense[]
  supplierPayments  SupplierPayment[]

  @@unique([workspaceId, name])
  @@map("payment_methods")
}

model Payment {
  id              String            @id @default(cuid())
  workspaceId     String            @map("workspace_id")
  workspace       Workspace         @relation(fields: [workspaceId], references: [id])
  paymentNumber   String            @map("payment_number")
  type            PaymentType
  status          PaymentStatus     @default(CONFIRMED)
  orderId         String?           @map("order_id")
  order           Order?            @relation(fields: [orderId], references: [id])
  customerId      String?           @map("customer_id")
  customer        Customer?         @relation(fields: [customerId], references: [id])
  returnId        String?           @map("return_id")
  return          Return?           @relation(fields: [returnId], references: [id])
  /// Null for CREDIT_APPLIED, which moves no money.
  paymentMethodId String?           @map("payment_method_id")
  paymentMethod   PaymentMethod?    @relation(fields: [paymentMethodId], references: [id])
  accountId       String?           @map("account_id")
  account         FinancialAccount? @relation(fields: [accountId], references: [id])
  /// Always positive; the direction is given by the type.
  amount          Decimal           @db.Decimal(18, 4)
  paidAt          DateTime          @default(now()) @map("paid_at")
  referenceNumber String?           @map("reference_number")
  proofFileId     String?           @map("proof_file_id")
  note            String?
  posSessionId    String?           @map("pos_session_id")
  posSession      PosSession?       @relation(fields: [posSessionId], references: [id])
  recordedById    String?           @map("recorded_by_id")
  confirmedById   String?           @map("confirmed_by_id")
  confirmedAt     DateTime?         @map("confirmed_at")
  rejectedReason  String?           @map("rejected_reason")
  voidedById      String?           @map("voided_by_id")
  voidedAt        DateTime?         @map("voided_at")
  voidReason      String?           @map("void_reason")
  createdAt       DateTime          @default(now()) @map("created_at")
  credits         CustomerCredit[]
  receipts        Receipt[]

  @@unique([workspaceId, paymentNumber])
  @@index([workspaceId, orderId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, status, paidAt])
  @@map("payments")
}

/// A ledger: a customer's credit balance is the sum of `amount`.
model CustomerCredit {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  customerId  String    @map("customer_id")
  customer    Customer  @relation(fields: [customerId], references: [id])
  /// Signed.
  amount      Decimal   @db.Decimal(18, 4)
  /// ADVANCE | OVERPAYMENT | REFUND_TO_CREDIT | APPLIED | ADJUSTMENT
  reason      String
  paymentId   String?   @map("payment_id")
  payment     Payment?  @relation(fields: [paymentId], references: [id])
  orderId     String?   @map("order_id")
  order       Order?    @relation(fields: [orderId], references: [id])
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, customerId])
  @@map("customer_credits")
}

model Receipt {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  receiptNumber String    @map("receipt_number")
  orderId       String?   @map("order_id")
  order         Order?    @relation(fields: [orderId], references: [id])
  paymentId     String?   @map("payment_id")
  payment       Payment?  @relation(fields: [paymentId], references: [id])
  /// SALE | PAYMENT | REFUND
  type          String    @default("SALE")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  /// The immutable snapshot the receipt is drawn from.
  data          Json
  reprintCount  Int       @default(0) @map("reprint_count")

  @@unique([workspaceId, receiptNumber])
  @@index([workspaceId, orderId])
  @@map("receipts")
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  name        String
  active      Boolean   @default(true)
  expenses    Expense[]

  @@unique([workspaceId, name])
  @@map("expense_categories")
}

model Expense {
  id               String           @id @default(cuid())
  workspaceId      String           @map("workspace_id")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id])
  categoryId       String           @map("category_id")
  category         ExpenseCategory  @relation(fields: [categoryId], references: [id])
  amount           Decimal          @db.Decimal(18, 4)
  expenseDate      DateTime         @map("expense_date")
  paymentMethodId  String           @map("payment_method_id")
  paymentMethod    PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  accountId        String           @map("account_id")
  account          FinancialAccount @relation(fields: [accountId], references: [id])
  description      String?
  attachmentFileId String?          @map("attachment_file_id")
  /// POSTED | VOIDED
  status           String           @default("POSTED")
  voidReason       String?          @map("void_reason")
  customFields     Json             @default("{}") @map("custom_fields")
  recordedById     String?          @map("recorded_by_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([workspaceId, expenseDate])
  @@map("expenses")
}

// ═══ Inventory (task 45) ═════════════════════════════════════════════════

enum MovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  ADJUSTMENT_IN
  TRANSFER_IN
  RETURN_IN
  SALE
  ADJUSTMENT_OUT
  TRANSFER_OUT
  RETURN_TO_SUPPLIER

  @@map("movement_type")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED

  @@map("reservation_status")
}

/// The immutable stock ledger: a database trigger refuses UPDATE and DELETE.
model StockMovement {
  id            String            @id @default(cuid())
  workspaceId   String            @map("workspace_id")
  workspace     Workspace         @relation(fields: [workspaceId], references: [id])
  variantId     String            @map("variant_id")
  variant       ProductVariant    @relation(fields: [variantId], references: [id])
  locationId    String            @map("location_id")
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  movementType  MovementType      @map("movement_type")
  /// Signed, in the base unit.
  quantityDelta Decimal           @map("quantity_delta") @db.Decimal(18, 4)
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(18, 4)
  /// ORDER | PURCHASE | ADJUSTMENT | TRANSFER | RETURN | SUPPLIER_RETURN | COUNT | OPENING
  referenceType String?           @map("reference_type")
  referenceId   String?           @map("reference_id")
  reasonId      String?           @map("reason_id")
  reason        AdjustmentReason? @relation(fields: [reasonId], references: [id])
  batchNumber   String?           @map("batch_number")
  expiryDate    DateTime?         @map("expiry_date")
  serialNumber  String?           @map("serial_number")
  note          String?
  performedById String?           @map("performed_by_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([workspaceId, variantId, locationId, createdAt])
  @@index([workspaceId, referenceType, referenceId])
  @@map("stock_movements")
}

/// A projection: always equals the ledger and the active reservations.
model StockLevel {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  variantId   String            @map("variant_id")
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  locationId  String            @map("location_id")
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  onHand      Decimal           @default(0) @map("on_hand") @db.Decimal(18, 4)
  reserved    Decimal           @default(0) @db.Decimal(18, 4)
  avgCost     Decimal           @default(0) @map("avg_cost") @db.Decimal(18, 4)
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([workspaceId, variantId, locationId])
  @@map("stock_levels")
}

model StockReservation {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  orderId     String            @map("order_id")
  order       Order             @relation(fields: [orderId], references: [id])
  orderItemId String            @map("order_item_id")
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id])
  variantId   String            @map("variant_id")
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  locationId  String            @map("location_id")
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  quantity    Decimal           @db.Decimal(18, 4)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  closedAt    DateTime?         @map("closed_at")

  @@index([workspaceId, orderId])
  @@index([workspaceId, variantId, locationId, status])
  @@map("stock_reservations")
}

model AdjustmentReason {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  name        String
  active      Boolean         @default(true)
  movements   StockMovement[]

  @@unique([workspaceId, name])
  @@map("adjustment_reasons")
}

/// Stock counts are a Release 3 feature; the tables exist so that release adds no migration here.
model StockCount {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  locationId  String            @map("location_id")
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  /// OPEN | POSTED | CANCELLED
  status      String            @default("OPEN")
  createdById String?           @map("created_by_id")
  postedAt    DateTime?         @map("posted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  lines       StockCountLine[]

  @@index([workspaceId, locationId])
  @@map("stock_counts")
}

model StockCountLine {
  id           String         @id @default(cuid())
  workspaceId  String         @map("workspace_id")
  workspace    Workspace      @relation(fields: [workspaceId], references: [id])
  stockCountId String         @map("stock_count_id")
  stockCount   StockCount     @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  variantId    String         @map("variant_id")
  variant      ProductVariant @relation(fields: [variantId], references: [id])
  expectedQty  Decimal        @map("expected_qty") @db.Decimal(18, 4)
  countedQty   Decimal?       @map("counted_qty") @db.Decimal(18, 4)

  @@unique([workspaceId, stockCountId, variantId])
  @@map("stock_count_lines")
}

// ═══ Point of sale (task 50) ═════════════════════════════════════════════

model PosSession {
  id            String            @id @default(cuid())
  workspaceId   String            @map("workspace_id")
  workspace     Workspace         @relation(fields: [workspaceId], references: [id])
  cashierId     String            @map("cashier_id")
  cashier       User              @relation("PosCashier", fields: [cashierId], references: [id])
  locationId    String            @map("location_id")
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  /// OPEN | CLOSED. A cashier has at most one OPEN session (partial unique index in the migration).
  status        String            @default("OPEN")
  openedAt      DateTime          @default(now()) @map("opened_at")
  closedAt      DateTime?         @map("closed_at")
  openingFloat  Decimal           @default(0) @map("opening_float") @db.Decimal(18, 4)
  expectedClose Decimal?          @map("expected_close") @db.Decimal(18, 4)
  actualClose   Decimal?          @map("actual_close") @db.Decimal(18, 4)
  discrepancy   Decimal?          @db.Decimal(18, 4)
  closeNote     String?           @map("close_note")
  /// A snapshot of the daily closing report, written when the session closes.
  closingData   Json?             @map("closing_data")
  orders        Order[]
  returns       Return[]
  payments      Payment[]
  cashMovements CashMovement[]

  @@index([workspaceId, cashierId, status])
  @@map("pos_sessions")
}

/// Cash put into or taken out of the drawer during a session (Release 3 screens; the table exists now).
model CashMovement {
  id           String     @id @default(cuid())
  workspaceId  String     @map("workspace_id")
  workspace    Workspace  @relation(fields: [workspaceId], references: [id])
  posSessionId String     @map("pos_session_id")
  posSession   PosSession @relation(fields: [posSessionId], references: [id])
  /// IN | OUT
  direction    String
  amount       Decimal    @db.Decimal(18, 4)
  reason       String
  createdById  String?    @map("created_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([workspaceId, posSessionId])
  @@map("cash_movements")
}

// ═══ Purchasing (task 55) ════════════════════════════════════════════════

model Supplier {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  workspace      Workspace         @relation(fields: [workspaceId], references: [id])
  name           String
  contactName    String?           @map("contact_name")
  phone          String?
  email          String?
  address        String?
  notes          String?
  /// ACTIVE | ARCHIVED
  status         String            @default("ACTIVE")
  customFields   Json              @default("{}") @map("custom_fields")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]
  returns        SupplierReturn[]

  @@index([workspaceId, status, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  workspaceId  String              @map("workspace_id")
  workspace    Workspace           @relation(fields: [workspaceId], references: [id])
  orderNumber  String              @map("order_number")
  supplierId   String              @map("supplier_id")
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  locationId   String              @map("location_id")
  location     InventoryLocation   @relation(fields: [locationId], references: [id])
  /// A state key of the PURCHASE_ORDER workflow. RECEIVED and PARTIALLY_RECEIVED are set by goods receipt only.
  status       String              @default("draft")
  orderDate    DateTime            @default(now()) @map("order_date")
  expectedDate DateTime?           @map("expected_date")
  subtotal     Decimal             @db.Decimal(18, 4)
  taxAmount    Decimal             @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount  Decimal             @map("total_amount") @db.Decimal(18, 4)
  notes        String?
  customFields Json                @default("{}") @map("custom_fields")
  createdById  String?             @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  version      Int                 @default(1)
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]
  payments     SupplierPayment[]
  returns      SupplierReturn[]

  @@unique([workspaceId, orderNumber])
  @@index([workspaceId, supplierId, orderDate])
  @@index([workspaceId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  purchaseOrderId String         @map("purchase_order_id")
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNo          Int            @map("line_no")
  variantId       String         @map("variant_id")
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  /// In the purchase unit; the product's purchase unit factor converts it to the base unit on receipt.
  quantity        Decimal        @db.Decimal(18, 4)
  unitCost        Decimal        @map("unit_cost") @db.Decimal(18, 4)
  receivedQty     Decimal        @default(0) @map("received_qty") @db.Decimal(18, 4)
  returnedQty     Decimal        @default(0) @map("returned_qty") @db.Decimal(18, 4)
  lineTotal       Decimal        @map("line_total") @db.Decimal(18, 4)

  @@unique([workspaceId, purchaseOrderId, lineNo])
  @@index([workspaceId, purchaseOrderId])
  @@index([workspaceId, variantId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  receiptNumber   String        @map("receipt_number")
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String?       @map("received_by_id")
  receivedAt      DateTime      @default(now()) @map("received_at")
  note            String?
  /// [{ purchaseOrderItemId, variantId, quantity, unitCost }]
  lines           Json

  @@unique([workspaceId, receiptNumber])
  @@index([workspaceId, purchaseOrderId])
  @@map("goods_receipts")
}

/// Recorded in Release 3; the table exists now so payables can be read from one schema.
model SupplierPayment {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  supplierId      String           @map("supplier_id")
  supplier        Supplier         @relation(fields: [supplierId], references: [id])
  purchaseOrderId String?          @map("purchase_order_id")
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  paymentMethodId String           @map("payment_method_id")
  paymentMethod   PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  accountId       String           @map("account_id")
  account         FinancialAccount @relation(fields: [accountId], references: [id])
  amount          Decimal          @db.Decimal(18, 4)
  paidAt          DateTime         @map("paid_at")
  referenceNumber String?          @map("reference_number")
  status          PaymentStatus    @default(CONFIRMED)
  voidReason      String?          @map("void_reason")
  recordedById    String?          @map("recorded_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([workspaceId, supplierId, paidAt])
  @@map("supplier_payments")
}

/// Recorded in Release 3 (Requirement 38.8).
model SupplierReturn {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  returnNumber    String        @map("return_number")
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String        @map("supplier_id")
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  reason          String
  totalAmount     Decimal       @map("total_amount") @db.Decimal(18, 4)
  /// [{ purchaseOrderItemId, variantId, quantity, unitCost }]
  lines           Json
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([workspaceId, returnNumber])
  @@index([workspaceId, supplierId])
  @@map("supplier_returns")
}

// ═══ Commissions (task 59) ═══════════════════════════════════════════════

enum CommissionCalcType {
  PERCENTAGE
  FIXED_PER_ORDER
  FIXED_PER_UNIT

  @@map("commission_calc_type")
}

enum CommissionBase {
  NET_SALES
  GROSS_SALES
  GROSS_PROFIT

  @@map("commission_base")
}

enum CommissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  REVERSED

  @@map("commission_status")
}

model CommissionRule {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  workspace     Workspace          @relation(fields: [workspaceId], references: [id])
  name          String
  calcType      CommissionCalcType @map("calc_type")
  /// A percentage (12.5 = 12.5%) or an amount, by calcType.
  rate          Decimal            @db.Decimal(18, 4)
  baseType      CommissionBase     @default(NET_SALES) @map("base_type")
  /// ALL | CATEGORY | PRODUCT | ORDER_TYPE
  scope         String             @default("ALL")
  /// A category id, a product id or an order type; null for ALL.
  scopeId       String?            @map("scope_id")
  /// Null applies to every salesperson.
  salespersonId String?            @map("salesperson_id")
  salesperson   User?              @relation("CommissionRuleSalesperson", fields: [salespersonId], references: [id])
  priority      Int                @default(0)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at")
  commissions   Commission[]

  @@index([workspaceId, active, salespersonId])
  @@map("commission_rules")
}

model Commission {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  orderId         String           @map("order_id")
  order           Order            @relation(fields: [orderId], references: [id])
  /// Null for a per-order rule, which is not tied to one line.
  orderItemId     String?          @map("order_item_id")
  orderItem       OrderItem?       @relation(fields: [orderItemId], references: [id])
  salespersonId   String           @map("salesperson_id")
  salesperson     User             @relation("CommissionSalesperson", fields: [salespersonId], references: [id])
  ruleId          String?          @map("rule_id")
  rule            CommissionRule?  @relation(fields: [ruleId], references: [id])
  /// The rule's values at calculation time, so later edits do not rewrite history.
  ruleSnapshot    Json             @map("rule_snapshot")
  calculationBase Decimal          @map("calculation_base") @db.Decimal(18, 4)
  sharePercent    Decimal          @default(100) @map("share_percent") @db.Decimal(9, 4)
  /// Negative on a reversal row.
  amount          Decimal          @db.Decimal(18, 4)
  status          CommissionStatus @default(PENDING)
  reversalOfId    String?          @map("reversal_of_id")
  reversalOf      Commission?      @relation("CommissionReversal", fields: [reversalOfId], references: [id])
  reversals       Commission[]     @relation("CommissionReversal")
  approvedById    String?          @map("approved_by_id")
  approvedBy      User?            @relation("CommissionApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?        @map("approved_at")
  paidAt          DateTime?        @map("paid_at")
  paidMethod      String?          @map("paid_method")
  note            String?
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([workspaceId, salespersonId, status])
  @@index([workspaceId, orderId])
  @@index([workspaceId, createdAt])
  @@map("commissions")
}

// ═══ Messaging and AI (task 69) ══════════════════════════════════════════

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

model IntegrationConnection {
  id                String         @id @default(cuid())
  workspaceId       String         @map("workspace_id")
  workspace         Workspace      @relation(fields: [workspaceId], references: [id])
  /// WHATSAPP | FACEBOOK_LEADS | INSTAGRAM | AI_<name> | SMTP | S3
  provider          String
  /// CHANNEL | AI | EMAIL | STORAGE | PAYMENT
  type              String
  /// CONNECTED | DISCONNECTED | ERROR
  status            String         @default("CONNECTED")
  displayName       String?        @map("display_name")
  /// The receiving phone number id or page id; one workspace per (provider, account) across the platform
  /// (partial unique index in the migration).
  externalAccountId String?        @map("external_account_id")
  /// AES-256-GCM; never returned by any endpoint.
  configEncrypted   String         @map("config_encrypted")
  lastSuccessAt     DateTime?      @map("last_success_at")
  lastErrorAt       DateTime?      @map("last_error_at")
  lastError         String?        @map("last_error")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  conversations     Conversation[]

  @@unique([workspaceId, provider])
  @@map("integration_connections")
}

/// Received before the workspace is known, so it has no workspace relation; the account id finds it afterwards.
model WebhookEvent {
  id           String    @id @default(cuid())
  provider     String
  dedupeKey    String    @map("dedupe_key")
  workspaceId  String?   @map("workspace_id")
  connectionId String?   @map("connection_id")
  /// message | status | lead_form
  kind         String
  payload      Json
  /// RECEIVED | PROCESSED | FAILED | IGNORED
  status       String    @default("RECEIVED")
  attempts     Int       @default(0)
  error        String?
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")

  @@unique([provider, dedupeKey])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

model Conversation {
  id                String                @id @default(cuid())
  workspaceId       String                @map("workspace_id")
  workspace         Workspace             @relation(fields: [workspaceId], references: [id])
  connectionId      String                @map("connection_id")
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id])
  channelType       String                @map("channel_type")
  externalContactId String                @map("external_contact_id")
  contactName       String?               @map("contact_name")
  contactPhone      String?               @map("contact_phone")
  customerId        String?               @map("customer_id")
  customer          Customer?             @relation(fields: [customerId], references: [id])
  leadId            String?               @map("lead_id")
  lead              Lead?                 @relation(fields: [leadId], references: [id])
  assignedToId      String?               @map("assigned_to_id")
  assignedTo        User?                 @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  /// OPEN | PENDING | CLOSED
  status            String                @default("OPEN")
  unreadCount       Int                   @default(0) @map("unread_count")
  automationActive  Boolean               @default(true) @map("automation_active")
  aiEnabled         Boolean               @default(true) @map("ai_enabled")
  needsHuman        Boolean               @default(false) @map("needs_human")
  needsHumanReason  String?               @map("needs_human_reason")
  lastMessageAt     DateTime?             @map("last_message_at")
  lastInboundAt     DateTime?             @map("last_inbound_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  messages          Message[]
  aiSuggestions     AISuggestion[]

  @@unique([workspaceId, connectionId, externalContactId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedToId, status])
  @@index([workspaceId, customerId])
  @@index([workspaceId, leadId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  workspaceId       String           @map("workspace_id")
  workspace         Workspace        @relation(fields: [workspaceId], references: [id])
  conversationId    String           @map("conversation_id")
  conversation      Conversation     @relation(fields: [conversationId], references: [id])
  /// The provider's message id; null until the provider accepts an outbound message.
  externalId        String?          @map("external_id")
  direction         MessageDirection
  /// CUSTOMER | STAFF | AI | AUTOMATION | SYSTEM
  senderType        String           @map("sender_type")
  senderUserId      String?          @map("sender_user_id")
  senderUser        User?            @relation("MessageSender", fields: [senderUserId], references: [id])
  /// TEXT | IMAGE | DOCUMENT | AUDIO | VIDEO | LOCATION | TEMPLATE | UNSUPPORTED
  type              String           @default("TEXT")
  body              String?
  /// [{ fileId, name, mime }]
  attachments       Json             @default("[]")
  templateId        String?          @map("template_id")
  template          MessageTemplate? @relation(fields: [templateId], references: [id])
  /// QUEUED | SENT | DELIVERED | READ | FAILED | RECEIVED
  status            String           @default("QUEUED")
  failureReason     String?          @map("failure_reason")
  providerTimestamp DateTime         @map("provider_timestamp")
  channelMeta       Json?            @map("channel_meta")
  createdAt         DateTime         @default(now()) @map("created_at")

  @@unique([workspaceId, conversationId, externalId])
  @@index([workspaceId, conversationId, providerTimestamp])
  @@map("messages")
}

model MessageTemplate {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  name           String
  /// QUICK_REPLY | MESSAGE | PROVIDER | NOTIFICATION | BANK_DETAILS
  kind           String
  channel        String?
  body           String
  variables      String[]
  providerName   String?   @map("provider_name")
  language       String?
  /// APPROVED | PENDING | REJECTED
  providerStatus String?   @map("provider_status")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  messages       Message[]

  @@unique([workspaceId, kind, name])
  @@map("message_templates")
}

model ContactConsent {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  channelType       String    @map("channel_type")
  externalContactId String    @map("external_contact_id")
  customerId        String?   @map("customer_id")
  customer          Customer? @relation(fields: [customerId], references: [id])
  /// OPTED_IN | OPTED_OUT | UNKNOWN
  status            String    @default("UNKNOWN")
  source            String?
  changedAt         DateTime  @default(now()) @map("changed_at")

  @@unique([workspaceId, channelType, externalContactId])
  @@map("contact_consents")
}

model KnowledgeItem {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  title       String
  body        String
  active      Boolean   @default(true)
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, active])
  @@map("knowledge_items")
}

model QuestionFlow {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  /// Null is the default flow.
  categoryId  String?   @map("category_id")
  category    Category? @relation(fields: [categoryId], references: [id])
  /// [{ fieldKey, question }]
  steps       Json

  @@unique([workspaceId, categoryId])
  @@map("question_flows")
}

model AISuggestion {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  leadId         String?       @map("lead_id")
  lead           Lead?         @relation(fields: [leadId], references: [id])
  /// EXTRACTION | DRAFT_REPLY | SUMMARY | CLASSIFICATION | NEXT_ACTION | NOTE | NEXT_QUESTION
  type           String
  payload        Json
  flags          String[]
  confidence     Decimal?      @db.Decimal(5, 4)
  /// PENDING | APPROVED | EDITED | REJECTED | SUPERSEDED | AUTO_SENT
  status         String        @default("PENDING")
  decidedById    String?       @map("decided_by_id")
  decidedBy      User?         @relation("AISuggestionDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?     @map("decided_at")
  appliedPayload Json?         @map("applied_payload")
  createdAt      DateTime      @default(now()) @map("created_at")
  actionLogs     AIActionLog[]

  @@index([workspaceId, conversationId, createdAt])
  @@index([workspaceId, leadId])
  @@map("ai_suggestions")
}

model AIActionLog {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  workspace       Workspace     @relation(fields: [workspaceId], references: [id])
  conversationId  String?       @map("conversation_id")
  suggestionId    String?       @map("suggestion_id")
  suggestion      AISuggestion? @relation(fields: [suggestionId], references: [id])
  actionType      String        @map("action_type")
  providerName    String        @map("provider_name")
  modelVersion    String?       @map("model_version")
  promptVersion   String        @map("prompt_version")
  promptHash      String        @map("prompt_hash")
  responseHash    String?       @map("response_hash")
  inputTokens     Int           @default(0) @map("input_tokens")
  outputTokens    Int           @default(0) @map("output_tokens")
  latencyMs       Int?          @map("latency_ms")
  confidenceScore Decimal?      @map("confidence_score") @db.Decimal(5, 4)
  /// SUCCESS | FAILED | TIMEOUT | DISABLED | LIMIT_REACHED
  outcome         String
  error           String?
  humanApproved   Boolean       @default(false) @map("human_approved")
  approvedById    String?       @map("approved_by_id")
  approvedBy      User?         @relation("AIActionApprover", fields: [approvedById], references: [id])
  approvedAt      DateTime?     @map("approved_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, conversationId])
  @@map("ai_action_logs")
}

model AIUsage {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  day         DateTime  @db.Date
  requests    Int       @default(0)
  tokens      Int       @default(0)

  @@unique([workspaceId, day])
  @@map("ai_usage")
}
