# Copy to .env and replace every value marked CHANGE. Never commit .env.
NODE_ENV=development
APP_ENV=development
DATABASE_URL=postgresql://bms:bms@localhost:5432/bms
REDIS_URL=redis://localhost:6379

# RS256 key pair. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# Put each key on one line with \n for line breaks.
JWT_PRIVATE_KEY=CHANGE
JWT_PUBLIC_KEY=CHANGE
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# 32 random bytes, base64: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=CHANGE

# local | s3. The values below match docker-compose.yml (MinIO).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bms
S3_ACCESS_KEY=bmsaccess
S3_SECRET_KEY=bmssecretkey
S3_REGION=us-east-1
MAX_UPLOAD_MB=10

WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
WORKERS_IN_PROCESS=true

# Placeholders are accepted until the messaging phase (tasks 71-72).
META_APP_SECRET=CHANGE
META_WEBHOOK_VERIFY_TOKEN=CHANGE

# Optional
#SMTP_URL=
#SENTRY_DSN=

ALLOW_PUBLIC_SIGNUP=false
PLATFORM_AUTOMATION_ENABLED=false
SEED_ALLOW_PRODUCTION=false
